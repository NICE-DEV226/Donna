# app/chat/.env.template — reconstruit en app/chat/.env au déploiement.
# envconfiguration.inject: true (plugin.yaml) exige que ce fichier existe
# physiquement, sinon ManifestError et le plugin échoue à charger. Chaque
# KEY=${KEY} se résout contre la vraie variable d'environnement injectée
# par la plateforme ; absente, elle devient une chaîne vide plutôt qu'une
# erreur — provider cloud désactivé, repli automatique sur Ollama (voir
# main.py._build_default_provider).

CHAT_ANTHROPIC_API_KEY=${CHAT_ANTHROPIC_API_KEY}
CHAT_OPENAI_API_KEY=${CHAT_OPENAI_API_KEY}
CHAT_XAI_API_KEY=${CHAT_XAI_API_KEY}
CHAT_GROQ_API_KEY=${CHAT_GROQ_API_KEY}
CHAT_GEMINI_API_KEY=${CHAT_GEMINI_API_KEY}
