# ═══════════════════════════════════════════════════════════════════════════
# DONNA — POINT D'ENTRÉE UNIQUE DE CONFIGURATION OPS
#
# Tout ce qui se règle sans toucher au code est ici, groupé par préoccupation.
# Le code lit ces variables via extensions/donna_settings.py et
# extensions/worker_env.py (défauts = comportement actuel — rien à poser
# pour retrouver exactement le comportement par défaut).
#
# Ne JAMAIS commiter un vrai .env (gitignoré + garde make security-check).
# Copier : cp .env.example .env   (dev local uniquement ; en Docker/Dokploy,
# les variables sont injectées par la plateforme, pas par fichier).
# ═══════════════════════════════════════════════════════════════════════════

# ── Socle (requis en prod — l'entrypoint refuse de démarrer sans) ──────────
# SECRET_KEY=            # JWT/HMAC xcore (integration.docker.yaml)
# SERVER_KEY=            # IPC inter-plugins + signatures
# ALLOWED_ORIGINS=https://donna.example.com   # CORS prod (défaut dev : localhost:4200)
# FORWARDED_ALLOW_IPS=10.0.0.0/8              # reverse-proxy de confiance (vide = aucun)
# LOG_LEVEL=info         # debug ponctuellement pour investiguer

# ── Redis ───────────────────────────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379            # attente au boot (entrypoint)
# PUBSUB_REDIS_URL=redis://localhost:6379/    # base SANS numéro (prod) — chaque
#                                             # service ajoute son chiffre (voir
#                                             # integration.docker.yaml + worker_env)
# Dérivés worker (défauts localhost:0/2 — poser en prod, ex ${PUBSUB_REDIS_URL}0) :
# DONNA_REMINDER_REDIS_URL=redis://localhost:6379/0
# DONNA_RAG_STATUS_REDIS_URL=redis://localhost:6379/2
# DONNA_DB_URL=sqlite:///data/db.sqlite3
# DONNA_DB_URL_ASYNC=sqlite+aiosqlite:///data/db.sqlite3

# ── Fournisseurs LLM (plugin chat) ─────────────────────────────────────────
# REQUISES par le manifeste (env: du plugin.yaml) — une variable simplement
# absente le ferait passer en « skipped ». Vides = repli Ollama local ; c'est
# le réglage par défaut. Ne renseigner que celles à activer ; le provider
# actif se pilote via llm.provider dans app/chat/plugin.yaml.
CHAT_ANTHROPIC_API_KEY=
CHAT_OPENAI_API_KEY=
CHAT_XAI_API_KEY=        # grok (xAI) — ne pas confondre avec Groq ci-dessous
CHAT_GROQ_API_KEY=       # groq (api.groq.com)
CHAT_GEMINI_API_KEY=
CHAT_OPENROUTER_API_KEY=

# ── Embeddings RAG — DOIVENT matcher API ↔ worker (même provider/modèle/dim,
# sinon recherche vectorielle cassée, dimension figée dans vec0) ─────────────
# OLLAMA_BASE_URL=http://localhost:11434
# RAG_EMBED_PROVIDER=ollama      # ollama | jina | gemini
# RAG_EMBED_MODEL=nomic-embed-text
# RAG_EMBED_DIM=768              # jina-embeddings-v5-text-small: 1024, gemini: 3072
# RAG_EMBED_API_KEY=             # requis si provider != ollama
# RAG_EMBED_BASE_URL=            # défaut auto par provider, rarement utile

# ── Budget tokens / boucle d'outils (le poste de dépense n°1) ───────────────
# DONNA_MAX_TOOL_ROUNDS=12                # allers-retours modèle→outil max
# DONNA_MAX_INPUT_TOKENS_PER_REQUEST=80000 # cumulé tous rounds : dépassé →
#                                         # réponse finale forcée SANS outils
# DONNA_TOOL_RESULT_MAX_CHARS=6000        # plafond par résultat d'outil
#                                         # réinjecté (anti-fuite MCP)

# ── RAG (requête) ───────────────────────────────────────────────────────────
# DONNA_RAG_TOP_K=5
# DONNA_RAG_GATE_ENABLED=true   # saute la recherche pour les "ok/merci"
# DONNA_RAG_GATE_MIN_CHARS=24
# DONNA_RERANK_MIN_SCORE=0.0

# ── Historique / mémoire ────────────────────────────────────────────────────
# DONNA_MAX_HISTORY_CHARS=12000  # plafond DUR du contexte historique
# DONNA_SUMMARY_TRIGGER=20       # messages non résumés avant re-résumé
# DONNA_SUMMARY_KEEP_RECENT=10   # toujours envoyés en clair
# DONNA_SUMMARY_MAX_CHARS=3000
# DONNA_ENABLE_TITLE_GEN=true    # titre auto (appel LLM local de fond)
# DONNA_ENABLE_SUMMARY=true      # résumé glissant (appel LLM local de fond)

# ── Upload / transcription ──────────────────────────────────────────────────
# DONNA_MAX_FILES_PER_REQUEST=10
# DONNA_MAX_AUDIO_BYTES=10485760  # 10 Mo
# DONNA_TRANSCRIBE_TIMEOUT_S=600
# DONNA_MAX_EXTRACTED_CHARS=20000 # texte de PJ accepté dans le message

# ── Rate limits HTTP (par utilisateur) ───────────────────────────────────────
# DONNA_CHAT_PER_MINUTE=60
# DONNA_STREAM_PER_MINUTE=60
# DONNA_UPLOAD_PER_10MIN=10      # fenêtre de 10 minutes (Whisper = CPU)

# ── Chunking ingestion (worker RAG) ─────────────────────────────────────────
# DONNA_CHUNK_SIZE=800
# DONNA_CHUNK_OVERLAP=100
# DONNA_EMBED_BATCH_SIZE=16  # chunks par appel embeddings (100 chunks ≈ 7 allers-retours)

# ── Email / OAuth (voir app/xauth/example.env pour le détail) ───────────────
# XAUTH_SMTP_HOST= / XAUTH_SMTP_PORT= / XAUTH_SMTP_USER= / XAUTH_SMTP_PASSWORD=
# XAUTH_SMTP_FROM= / XAUTH_SMTP_FROM_NAME= / XAUTH_SMTP_USE_TLS=true
# XAUTH_OAUTH_GOOGLE_CLIENT_ID= / XAUTH_OAUTH_GOOGLE_CLIENT_SECRET= (+ github…)
